# URL backend FastAPI (Cloud Run khi deploy)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL của chính trang web, dùng cho link chia sẻ và thẻ og
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth Client ID (giống GOOGLE_CLIENT_ID ở backend). Trống = ẩn nút đăng nhập
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
