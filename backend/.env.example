# Bỏ trống GOOGLE_API_KEY (hoặc LLM_FAKE=1) để chạy bằng FakeLLM, không tốn quota
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Chuỗi dự phòng (phẩy ngăn cách), thử lần lượt khi model trước hết lượt/quá tải
GEMINI_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_REASONING_EFFORT=low                   # minimal | low | medium | high; để trống = mặc định của model

# Local: SQLite. Deploy: chuỗi kết nối Neon, ví dụ postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=

STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=chememe
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

ALLOWED_ORIGINS=http://localhost:3000

# Đăng nhập Google: OAuth Client ID loại "Web application". Trống = tắt đăng nhập (khách vẫn dùng được)
GOOGLE_CLIENT_ID=
# Lượt chế trong 24 giờ
QUOTA_USER_PER_DAY=20
QUOTA_ANON_PER_DAY=5
IP_HASH_SALT=change-me

# LangSmith tracing (tuỳ chọn)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=chememe
